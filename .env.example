# Copy to .env and adjust. Defaults work with Docker Postgres + local Ollama.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384

# Option A (default, free): Ollama on your machine
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Option B: Groq free tier (faster, needs a free API key from console.groq.com)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=llama-3.1-8b-instant

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
